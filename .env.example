# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres connection string.
# Supabase dashboard -> Connect -> "Session pooler" URI (host *.pooler.supabase.com, port 5432).
# The direct host (db.xxxx.supabase.co) is IPv6-only and will NOT work from Render.
# URL-encode special characters in the password (e.g. @ -> %40).
# Do NOT add ?sslmode=require — SSL is configured in src/config/db.js.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Owner account (used once by `npm run seed`)
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-strong-password
